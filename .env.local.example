# ==============================================================================
# Rentify Property Rental & Booking Platform - Frontend Environment Variables
# ==============================================================================
# Copy this file to '.env.local' for local development.
# Next.js automatically loads '.env.local' in local development environments.
# Note: Next.js exposes environment variables starting with 'NEXT_PUBLIC_' to the browser.
# ==============================================================================

# 1. Centralized Express Backend REST API URL (Required)
# Must point to your running Node.js / Express API server.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# 2. Better Auth Base Server URL (Required for Better Auth Client)
# Points to the base origin of your auth server.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000

# 3. Stripe Publishable Key (Required for Client Checkout & Payment Element)
# ONLY use your publishable key (starts with 'pk_test_' or 'pk_live_').
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key_here

# 4. Google OAuth Client ID (Optional / Recommended for Better Auth Google OAuth)
# Used by client-side Google sign-in components.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com


# ==============================================================================
# SECURITY & ISOLATION CHECKLIST (CRITICAL RULES)
# ==============================================================================
# NEVER expose or include any of the following backend secrets in frontend environment files:
# ❌ NO MongoDB Connection Strings (e.g., mongodb+srv://...)
# ❌ NO JWT Secret Keys (e.g., JWT_SECRET=...)
# ❌ NO Stripe Secret Keys (e.g., sk_test_... or sk_live_...)
# ❌ NO Google OAuth Client Secrets (e.g., GOOGLE_CLIENT_SECRET=...)
# ❌ NO Session Secret Keys
#
# Backend secrets must remain strictly isolated inside the 'Rent-Server' project environment.
# ==============================================================================
